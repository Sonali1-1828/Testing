
@{
    ViewData["Title"] = "Home Page";
}
<style>
    .blink {
        animation: blink 1s infinite;
        color: red;
        font-weight: 800;
        font-size: 42px;
    }
    @@keyframes blink {
        0% { opacity: 1; }
        50% { opacity: 0; }
        100% { opacity: 1; }
    }
    .main-img {
        width: 100%;
        height: 380px;
        object-fit: cover;
        border-radius: 15px;
        border: 4px solid #FFC107;
        box-shadow: 0 10px 25px rgba(0,0,0,0.2);
    }
</style>

<div class="text-center">
    <h1 class="blink">Welcome to Home Page!</h1>
    <p class="fw-bold">Employee Management System - Manage Your Team Easily</p>

    <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=1200&q=80" class="main-img" alt="Employee Management" />

    <div class="mt-4">
        <a class="btn btn-dark btn-lg" style="border-radius:0" asp-controller="Account" asp-action="Login">🔐 Login</a>
        <a class="btn btn-warning btn-lg" style="border-radius:0" asp-controller="Account" asp-action="Register">✍️ Register New User</a>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-4"><div class="card text-center p-3 shadow"><h4>👥 Employees</h4><p>View, Add & Manage Employees</p><a asp-controller="Employee" asp-action="Index" class="btn btn-primary" style="border-radius:0">View Employees</a></div></div>
    <div class="col-md-4"><div class="card text-center p-3 shadow"><h4>🏢 Departments</h4><p>IT, HR, Finance Departments</p><a asp-controller="Employee" asp-action="Index" class="btn btn-success" style="border-radius:0">Explore</a></div></div>
    <div class="col-md-4"><div class="card text-center p-3 shadow"><h4>🛡️ Admin Role</h4><p>Secure Admin & User Login</p><a asp-controller="Account" asp-action="Login" class="btn btn-dark" style="border-radius:0">Admin Login</a></div></div>
</div>